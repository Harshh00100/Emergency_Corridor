# Public browser configuration only. Do not place private keys in VITE_* variables.
VITE_OSRM_BASE_URL=https://router.project-osrm.org
VITE_OVERPASS_API_URL=https://overpass-api.de/api/interpreter
VITE_DEFAULT_MAP_LAT=28.6139
VITE_DEFAULT_MAP_LNG=77.2090
VITE_DEFAULT_MAP_ZOOM=11
VITE_REQUEST_TIMEOUT_MS=8000
VITE_ENABLE_DEMO_FALLBACK=true
# Optional application gateway; blank keeps clearance alerts in local demo mode.
# Example: https://your-gateway.example/api/clearance-requests
VITE_SIGNAL_ALERT_URL=
